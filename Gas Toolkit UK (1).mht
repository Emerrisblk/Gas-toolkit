@charset "utf-8";

:root { --bg: #f4f5f7; --card: #fff; --tx: #14181f; --mu: #5d6675; --ac: #e8590c; --ln: #dde1e7; --ok: #1a7f4b; --bad: #c92a2a; box-sizing: border-box; padding-top: env(safe-area-inset-top,0px); padding-bottom: env(safe-area-inset-bottom,0px); color-scheme: light; }

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) { --bg: #0f1217; --card: #1a1f27; --tx: #eef0f3; --mu: #9aa3b2; --ln: #2c333e; --ac: #ff8a4c; --ok: #4cc38a; --bad: #ff6b6b; color-scheme: dark; }
}

:root[data-theme="dark"] { --bg: #0f1217; --card: #1a1f27; --tx: #eef0f3; --mu: #9aa3b2; --ln: #2c333e; --ac: #ff8a4c; --ok: #4cc38a; --bad: #ff6b6b; color-scheme: dark; }

* { box-sizing: border-box; }

body { margin: 0px; background: var(--bg); color: var(--tx); font: 16px / 1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }

main { max-width: 560px; margin: 0px auto; padding: 12px; }

h1 { font-size: 1.3rem; margin: 8px 0px; }

nav { display: flex; gap: 8px; margin-bottom: 12px; }

nav button { flex: 1 1 0%; padding: 12px; border: 1px solid var(--ln); background: var(--card); color: var(--tx); border-radius: 10px; font-weight: 600; font-size: 1rem; }

nav button.on { background: var(--ac); color: rgb(255, 255, 255); border-color: var(--ac); }

.card { background: var(--card); border: 1px solid var(--ln); border-radius: 12px; padding: 14px; margin-bottom: 12px; }

label { display: block; font-size: 0.85rem; color: var(--mu); margin: 10px 0px 4px; }

input, select { width: 100%; padding: 11px; font-size: 1rem; border: 1px solid var(--ln); border-radius: 8px; background: var(--bg); color: var(--tx); }

.row { display: flex; gap: 8px; }

.row > * { flex: 1 1 0%; }

.big { font-size: 2rem; font-weight: 700; color: var(--ac); }

.res { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 12px; }

.res div { background: var(--bg); border-radius: 8px; padding: 10px; }

.res small { color: var(--mu); display: block; }

.btn { padding: 12px; border: 0px; border-radius: 10px; background: var(--ac); color: rgb(255, 255, 255); font-weight: 600; font-size: 1rem; width: 100%; margin-top: 10px; }

.btn.alt { background: var(--bg); color: var(--tx); border: 1px solid var(--ln); }

.note { font-size: 0.8rem; color: var(--mu); }

.ok { color: var(--ok); font-weight: 600; }

.bad { color: var(--bad); font-weight: 600; }

.item { display: grid; grid-template-columns: 1fr 64px 84px 36px; gap: 6px; margin-top: 6px; }

.tot { text-align: right; margin-top: 10px; }

.hide { display: none; }

.sw { display: flex; align-items: center; gap: 8px; margin-top: 10px; }

.sw b { font-size: 1.6rem; min-width: 96px; font-variant-numeric: tabular-nums; }

.sw .btn { margin: 0px; flex: 1 1 0%; }

#cpa input, #cpa select, #cpf input, #cpf select { margin-top: 6px; }

.cpg { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }

table { width: 100%; border-collapse: collapse; }

td, th { padding: 6px 4px; border-bottom: 1px solid var(--ln); text-align: left; }

td:last-child, th:last-child { text-align: right; }

th[colspan] { text-align: left; }

@media print {
  nav, .btn, .noprint, #tab-rate { display: none !important; }
  body { background: rgb(255, 255, 255); color: rgb(0, 0, 0); }
  .card { border: 0px; }
}

nav button { font-size: 0.82rem; padding: 12px 2px; }

.v { padding: 10px; border-radius: 8px; margin-top: 10px; font-weight: 600; }

.v.ok { background: rgba(26, 127, 75, 0.15); }

.v.bad { background: rgba(201, 42, 42, 0.15); }

.v.wn { background: rgba(232, 89, 12, 0.15); color: var(--ac); }

#cpdoc { width: 1040px; background: rgb(255, 255, 255); color: rgb(17, 17, 17); font: 11px / 1.3 Arial, Helvetica, sans-serif; padding: 6px; }

#cpdoc .fx { display: flex; gap: 4px; }

#cpdoc .fx > .pn { flex: 1 1 0%; }

#cpdoc .pn { background: rgb(228, 238, 251); border: 1px solid rgb(197, 211, 230); padding: 4px; }

#cpdoc .hd { display: inline-block; background: rgb(22, 64, 90); color: rgb(255, 255, 255); padding: 1px 5px; margin: 0px 4px 3px 0px; font-size: 12px; }

#cpdoc .kv { display: grid; grid-template-columns: 78px 1fr; gap: 2px 6px; align-items: start; }

#cpdoc .v, #cpdoc .bx { background: rgb(255, 255, 255); border: 1px solid rgb(197, 211, 230); padding: 0px 4px; min-height: 15px; display: inline-block; word-break: break-word; }

#cpdoc .kv .v { display: block; }

#cpdoc table { border-collapse: collapse; width: 100%; font-size: 9px; margin-top: 2px; }

#cpdoc td, #cpdoc th { border: 1px solid rgb(197, 211, 230); padding: 2px; background: rgb(255, 255, 255); font-weight: 400; color: rgb(17, 17, 17); vertical-align: middle; text-align: center !important; }

#cpdoc th { background: rgb(228, 238, 251); }

#cpdoc td.l { text-align: left !important; }

#cpdoc p { margin: 3px 0px; }

@media print {
  #cpout { height: auto !important; overflow: visible !important; }
  #cpprev { transform: none !important; width: 100% !important; }
}
